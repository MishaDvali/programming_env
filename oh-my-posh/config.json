{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#E6EDF3",
          "background": "#29315A",
          "template": " \uf07b {{ .Path }} ",
          "options": {
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "\ue0b4",
          "foreground": "#43CCEA",
          "background": "#29315A",
          "template": " \ue725 {{ .HEAD }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .Ahead 0 }} \uf062{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} \uf063{{ .Behind }}{{ end }} ",
          "options": {
            "fetch_status": true
          }
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "\ue0b4",
          "foreground": "#B7C9E2",
          "background": "#29315A",
          "template": " \ueba2 {{ .FormattedMs }} ",
          "options": {
            "always_enabled": true,
            "style": "roundrock",
            "threshold": 0
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#FFFFFF",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#FF5F56{{ end }}"
          ],
          "template": "\u276f ",
          "options": {
            "always_enabled": true
          }
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#FFFFFF",
    "foreground_templates": [
      "{{ if gt .Code 0 }}#FF5F56{{ end }}"
    ],
    "template": "\u276f "
  }
}
